# Server port (hosting platforms usually set this for you)
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/bookbase

# Secret used to sign login tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS, comma-separated.
# Leave empty during development to allow any origin.
CLIENT_URL=http://localhost:5173

# Set to false to stop people from registering as Admin from the public form
ALLOW_ADMIN_REGISTRATION=true

# Uses Google DNS so MongoDB Atlas SRV URLs resolve on all networks. Set false to disable.
CUSTOM_DNS=true
